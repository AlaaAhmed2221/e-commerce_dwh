union all
select 'orders', (select count(*) from bronze.olist_orders), (select count(*) from silver.olist_orders)
union all
select 'products', (select count(*) from bronze.olist_products), (select count(*) from silver.olist_products)
union all
select 'order_items', (select count(*) from bronze.olist_order_items), (select count(*) from silver.olist_order_items);
