PRINT '>> Truncating Table: bronze.olist_order_items'
TRUNCATE TABLE bronze.olist_order_items;
PRINT '>> Inserting Data Into: bronze.olist_order_items'
    INSERT INTO bronze.olist_order_items
    (
        order_id ,
		order_item_id ,
		product_id ,
